+
+void turn_on_robot::Check_Actuator_Deadline()
+{
+  const auto now = senior_motion_msgs::navigation::monotonic_ns();
+  if (last_actuator_check_ > now) actuator_clock_invalid_ = true;
+  last_actuator_check_ = now;
+  if (actuator_moving_ && (actuator_clock_invalid_ || now >= actuator_deadline_)) {
+    geometry_msgs::msg::Twist zero;
+    if (Write_Actuator(zero, 0)) actuator_moving_ = false;
+  }
+}
