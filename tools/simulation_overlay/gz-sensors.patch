+void Sensor::SetSourceTimingStart(const std::chrono::steady_clock::duration &_simTime,
+                                  uint64_t _hostSteady, const std::string &_measurementEpoch)
+{
+  if (_hostSteady == 0 || _measurementEpoch.empty()) {
+    this->dataPtr->sourceInputSteady = 0; this->dataPtr->sourceProof = {}; return;
+  }
+  if (!this->dataPtr->sourceClock)
+    this->dataPtr->sourceClock = std::make_unique<senior_motion_msgs::timing::DriverClock>();
+  if (this->dataPtr->sourceMeasurementEpoch != _measurementEpoch)
+    this->dataPtr->nextUpdateTime = _simTime;
+  this->dataPtr->sourceMeasurementEpoch = _measurementEpoch;
+  this->dataPtr->sourceInputSeen = true;
+  this->dataPtr->sourceInputSim = _simTime;
+  this->dataPtr->sourceInputSteady = _hostSteady;
+}
+
+void Sensor::AddSourceTiming(gz::msgs::Header *_msg) const
+{
+  if (this->dataPtr->sourceProof.sequence > 0)
+    senior_motion_msgs::timing::attach(_msg, this->dataPtr->sourceProof);
+}
