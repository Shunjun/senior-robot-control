+// Copyright 2026 Senior Robot contributors. Licensed under Apache-2.0.
+#include "ros_gz_bridge/convert/senior_motion_msgs.hpp"
+#include "senior_motion_msgs/source_transport.hpp"
+namespace ros_gz_bridge {
+template<> void convert_gz_to_ros(const gz::msgs::LaserScan & input, senior_motion_msgs::msg::TimedLaserScan & output) {
+  convert_gz_to_ros(input, output.data);
+  // A malformed or missing original proof remains invalid; the factory drops it.
+  senior_motion_msgs::timing::extract(input.header(), output.timing);
+}
+template<> void convert_ros_to_gz(const senior_motion_msgs::msg::TimedLaserScan & input, gz::msgs::LaserScan & output) {
+  convert_ros_to_gz(input.data, output);
+  senior_motion_msgs::timing::attach(output.mutable_header(), input.timing);
+}
