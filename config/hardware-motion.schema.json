{
  "$defs": {
    "ControllerConfig": {
      "additionalProperties": false,
      "properties": {
        "kp": {
          "$ref": "#/$defs/Velocity"
        },
        "ki": {
          "$ref": "#/$defs/Velocity"
        },
        "integral_limit": {
          "$ref": "#/$defs/Velocity"
        },
        "track_width_m": {
          "title": "Track Width M",
          "type": "number"
        },
        "wheel_speed_mps": {
          "title": "Wheel Speed Mps",
          "type": "number"
        },
        "still_speed_mps": {
          "title": "Still Speed Mps",
          "type": "number"
        },
        "still_yaw_rps": {
          "title": "Still Yaw Rps",
          "type": "number"
        },
        "disagreement_mps": {
          "title": "Disagreement Mps",
          "type": "number"
        },
        "basis": {
          "title": "Basis",
          "type": "string"
        },
        "synthetic": {
          "title": "Synthetic",
          "type": "boolean"
        }
      },
      "required": [
        "kp",
        "ki",
        "integral_limit",
        "track_width_m",
        "wheel_speed_mps",
        "still_speed_mps",
        "still_yaw_rps",
        "disagreement_mps",
        "basis",
        "synthetic"
      ],
      "title": "ControllerConfig",
      "type": "object"
    },
    "DiagnosticsSettings": {
      "additionalProperties": false,
      "properties": {
        "queue": {
          "$ref": "#/$defs/QueueWarningPolicy",
          "default": {
            "count": 32,
            "ratio": 0.75,
            "repeat_s": 5.0,
            "recovery_ratio": 0.5,
            "oldest_wait_ms": 300.0
          }
        },
        "period_s": {
          "title": "Period S",
          "type": "number"
        }
      },
      "title": "DiagnosticsSettings",
      "type": "object"
    },
    "FusionConfig": {
      "additionalProperties": false,
      "properties": {
        "trusted_statistical_models": {
          "items": {
            "type": "string"
          },
          "title": "Trusted Statistical Models",
          "type": "array"
        },
        "normal_cap_mps": {
          "title": "Normal Cap Mps",
          "type": "number"
        },
        "degraded_cap_mps": {
          "title": "Degraded Cap Mps",
          "type": "number"
        },
        "conflict_linear_mps": {
          "title": "Conflict Linear Mps",
          "type": "number"
        },
        "conflict_yaw_rps": {
          "title": "Conflict Yaw Rps",
          "type": "number"
        }
      },
      "required": [
        "trusted_statistical_models",
        "normal_cap_mps",
        "degraded_cap_mps",
        "conflict_linear_mps",
        "conflict_yaw_rps"
      ],
      "title": "FusionConfig",
      "type": "object"
    },
    "OptionalMotionInput": {
      "additionalProperties": false,
      "properties": {
        "course_frame": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Course Frame"
        },
        "origin_family": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Origin Family"
        },
        "topic": {
          "pattern": "^/[A-Za-z_][A-Za-z0-9_/]*$",
          "title": "Topic",
          "type": "string"
        },
        "publisher": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "title": "Publisher",
          "type": "string"
        },
        "namespace": {
          "default": "/",
          "pattern": "^/(?:[A-Za-z_][A-Za-z0-9_/]*)?$",
          "title": "Namespace",
          "type": "string"
        }
      },
      "required": [
        "topic",
        "publisher"
      ],
      "title": "OptionalMotionInput",
      "type": "object"
    },
    "QueueWarningPolicy": {
      "additionalProperties": false,
      "properties": {
        "count": {
          "default": 32,
          "title": "Count",
          "type": "integer"
        },
        "ratio": {
          "default": 0.75,
          "title": "Ratio",
          "type": "number"
        },
        "repeat_s": {
          "default": 5.0,
          "title": "Repeat S",
          "type": "number"
        },
        "recovery_ratio": {
          "default": 0.5,
          "title": "Recovery Ratio",
          "type": "number"
        },
        "oldest_wait_ms": {
          "default": 300.0,
          "title": "Oldest Wait Ms",
          "type": "number"
        }
      },
      "title": "QueueWarningPolicy",
      "type": "object"
    },
    "Velocity": {
      "additionalProperties": false,
      "properties": {
        "vx": {
          "title": "Vx",
          "type": "number"
        },
        "wz": {
          "title": "Wz",
          "type": "number"
        }
      },
      "required": [
        "vx",
        "wz"
      ],
      "title": "Velocity",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "profile_id": {
      "minLength": 1,
      "title": "Profile Id",
      "type": "string"
    },
    "evidence_basis": {
      "default": "",
      "title": "Evidence Basis",
      "type": "string"
    },
    "operating_conditions": {
      "default": "",
      "title": "Operating Conditions",
      "type": "string"
    },
    "diagnostics": {
      "$ref": "#/$defs/DiagnosticsSettings"
    },
    "accel": {
      "exclusiveMinimum": 0,
      "title": "Accel",
      "type": "number"
    },
    "decel": {
      "exclusiveMinimum": 0,
      "title": "Decel",
      "type": "number"
    },
    "jerk": {
      "exclusiveMinimum": 0,
      "title": "Jerk",
      "type": "number"
    },
    "yaw_accel": {
      "exclusiveMinimum": 0,
      "title": "Yaw Accel",
      "type": "number"
    },
    "yaw_decel": {
      "exclusiveMinimum": 0,
      "title": "Yaw Decel",
      "type": "number"
    },
    "yaw_jerk": {
      "exclusiveMinimum": 0,
      "title": "Yaw Jerk",
      "type": "number"
    },
    "lag_ms": {
      "minimum": 0,
      "title": "Lag Ms",
      "type": "number"
    },
    "requested_linear_mps": {
      "default": 1.3888888888888888,
      "exclusiveMinimum": 0,
      "title": "Requested Linear Mps",
      "type": "number"
    },
    "degraded_cap": {
      "exclusiveMinimum": 0,
      "title": "Degraded Cap",
      "type": "number"
    },
    "yaw_cap": {
      "default": 2.0,
      "exclusiveMinimum": 0,
      "title": "Yaw Cap",
      "type": "number"
    },
    "length": {
      "default": 0.674,
      "exclusiveMinimum": 0,
      "title": "Length",
      "type": "number"
    },
    "width": {
      "default": 0.552,
      "exclusiveMinimum": 0,
      "title": "Width",
      "type": "number"
    },
    "track_width_m": {
      "default": 0.481154,
      "exclusiveMinimum": 0,
      "title": "Track Width M",
      "type": "number"
    },
    "wheel_speed_mps": {
      "exclusiveMinimum": 0,
      "title": "Wheel Speed Mps",
      "type": "number"
    },
    "stationary_linear_mps": {
      "exclusiveMinimum": 0,
      "title": "Stationary Linear Mps",
      "type": "number"
    },
    "stationary_yaw_rps": {
      "exclusiveMinimum": 0,
      "title": "Stationary Yaw Rps",
      "type": "number"
    },
    "startup_learning_front_occlusion_stop": {
      "default": true,
      "title": "Startup Learning Front Occlusion Stop",
      "type": "boolean"
    },
    "startup_learning_rear_occlusion_stop": {
      "default": true,
      "title": "Startup Learning Rear Occlusion Stop",
      "type": "boolean"
    },
    "linear_error": {
      "minimum": 0,
      "title": "Linear Error",
      "type": "number"
    },
    "yaw_error": {
      "minimum": 0,
      "title": "Yaw Error",
      "type": "number"
    },
    "sensor_error": {
      "minimum": 0,
      "title": "Sensor Error",
      "type": "number"
    },
    "position_error": {
      "minimum": 0,
      "title": "Position Error",
      "type": "number"
    },
    "assumed_body_cap": {
      "exclusiveMinimum": 0,
      "title": "Assumed Body Cap",
      "type": "number"
    },
    "drive_linear_overshoot": {
      "minimum": 0,
      "title": "Drive Linear Overshoot",
      "type": "number"
    },
    "drive_yaw_overshoot": {
      "minimum": 0,
      "title": "Drive Yaw Overshoot",
      "type": "number"
    },
    "horizon_s": {
      "default": 12.0,
      "description": "Software stop-search horizon; physical envelope must cover this horizon",
      "exclusiveMinimum": 0,
      "title": "Horizon S",
      "type": "number"
    },
    "orientation_error_rad": {
      "minimum": 0,
      "title": "Orientation Error Rad",
      "type": "number"
    },
    "lateral_drift_mps": {
      "minimum": 0,
      "title": "Lateral Drift Mps",
      "type": "number"
    },
    "lateral_stop_ms": {
      "minimum": 0,
      "title": "Lateral Stop Ms",
      "type": "number"
    },
    "reaction_linear_accel": {
      "minimum": 0,
      "title": "Reaction Linear Accel",
      "type": "number"
    },
    "reaction_yaw_accel": {
      "minimum": 0,
      "title": "Reaction Yaw Accel",
      "type": "number"
    },
    "watchdog_mode": {
      "default": "unknown",
      "enum": [
        "verified",
        "unknown"
      ],
      "title": "Watchdog Mode",
      "type": "string"
    },
    "watchdog_basis": {
      "default": "Target firmware watchdog behavior unconfirmed",
      "title": "Watchdog Basis",
      "type": "string"
    },
    "perception_basis": {
      "default": "original raw lidar; hardware no-return remains unknown",
      "title": "Perception Basis",
      "type": "string"
    },
    "risk_basis": {
      "default": "",
      "title": "Risk Basis",
      "type": "string"
    },
    "brake_tracking_basis": {
      "default": "",
      "title": "Brake Tracking Basis",
      "type": "string"
    },
    "fusion_config": {
      "anyOf": [
        {
          "$ref": "#/$defs/FusionConfig"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "controller_config": {
      "anyOf": [
        {
          "$ref": "#/$defs/ControllerConfig"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "gps_input": {
      "anyOf": [
        {
          "$ref": "#/$defs/OptionalMotionInput"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "rgbd_input": {
      "anyOf": [
        {
          "$ref": "#/$defs/OptionalMotionInput"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "wheel_topic": {
      "default": "/odom",
      "pattern": "^/[A-Za-z_][A-Za-z0-9_/]*$",
      "title": "Wheel Topic",
      "type": "string"
    },
    "imu_topic": {
      "default": "/imu/data_raw",
      "pattern": "^/[A-Za-z_][A-Za-z0-9_/]*$",
      "title": "Imu Topic",
      "type": "string"
    },
    "wheel_publisher": {
      "default": "wheeltec_robot",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
      "title": "Wheel Publisher",
      "type": "string"
    },
    "imu_publisher": {
      "default": "wheeltec_robot",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
      "title": "Imu Publisher",
      "type": "string"
    },
    "source_namespace": {
      "default": "/",
      "pattern": "^/(?:[A-Za-z_][A-Za-z0-9_]*(?:/[A-Za-z_][A-Za-z0-9_]*)*)?$",
      "title": "Source Namespace",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "profile_id",
    "accel",
    "decel",
    "jerk",
    "yaw_accel",
    "yaw_decel",
    "yaw_jerk",
    "lag_ms",
    "degraded_cap",
    "wheel_speed_mps",
    "stationary_linear_mps",
    "stationary_yaw_rps",
    "linear_error",
    "yaw_error",
    "sensor_error",
    "position_error",
    "assumed_body_cap",
    "drive_linear_overshoot",
    "drive_yaw_overshoot",
    "orientation_error_rad",
    "lateral_drift_mps",
    "lateral_stop_ms",
    "reaction_linear_accel",
    "reaction_yaw_accel"
  ],
  "title": "HardwareMotionProfile",
  "type": "object"
}
