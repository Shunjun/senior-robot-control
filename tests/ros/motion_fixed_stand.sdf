<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.7">
  <world name="motion_qualification">
    <gravity>0 0 0</gravity>
    <physics name="default" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>
    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics" />
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands" />
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster" />
    <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="ignition-gazebo-imu-system" name="ignition::gazebo::systems::Imu" />
    <light type="directional" name="sun">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <direction>-0.5 0.1 -0.9</direction>
    </light>
    <model name="ground">
      <pose>0 0 -0.2 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>50 50</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>50 50</size>
            </plane>
          </geometry>
        </visual>
      </link>
    </model>
    <model name="east">
      <static>true</static>
      <pose>4 0 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.2 6 1.5</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.2 6 1.5</size>
            </box>
          </geometry>
        </visual>
      </link>
    </model>
    <model name="west">
      <static>true</static>
      <pose>-3.5 0 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.2 6 1.5</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.2 6 1.5</size>
            </box>
          </geometry>
        </visual>
      </link>
    </model>
    <model name="north">
      <static>true</static>
      <pose>0.25 3 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>7.5 0.2 1.5</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>7.5 0.2 1.5</size>
            </box>
          </geometry>
        </visual>
      </link>
    </model>
    <model name="south">
      <static>true</static>
      <pose>0.25 -3 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>7.5 0.2 1.5</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>7.5 0.2 1.5</size>
            </box>
          </geometry>
        </visual>
      </link>
    </model>
    <model name="feature">
      <static>true</static>
      <pose>2 1.2 0.75 0 0 0.2</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.4 0.7 1.5</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.4 0.7 1.5</size>
            </box>
          </geometry>
        </visual>
      </link>
    </model>
    <model name="motion_test_stand">
      <static>false</static>
      <link name="anchor">
        <inertial>
          <mass>1.0</mass>
          <inertia><ixx>0.01</ixx><iyy>0.01</iyy><izz>0.01</izz></inertia>
        </inertial>
      </link>
      <joint name="world_anchor" type="fixed">
        <parent>world</parent>
        <child>anchor</child>
      </joint>
      <plugin filename="ignition-gazebo-detachable-joint-system" name="ignition::gazebo::systems::DetachableJoint">
        <parent_link>anchor</parent_link>
        <child_model>senior</child_model>
        <child_link>base_link</child_link>
        <suppress_child_warning>true</suppress_child_warning>
        <output_topic>/qualification/stand_state</output_topic>
        <detach_topic>/qualification/stand_detach</detach_topic>
        <attach_topic>/qualification/stand_attach</attach_topic>
      </plugin>
    </model>
  </world>
</sdf>
