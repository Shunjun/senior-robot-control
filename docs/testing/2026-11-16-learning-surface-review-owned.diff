+    core.node._scan_topology_ready = lambda: True
+    core.node._profile = lambda: DeviceProfile(
+        footprint=[(-0.337, -0.276), (0.337, -0.276), (0.337, 0.276), (-0.337, 0.276)]
+    )
+    now = [10.0]
+    monkeypatch.setattr("senior_robot.motion_core_output.time.monotonic", lambda: now[0])
+    losses = []
+    missing = []
+    original = core._decision_output
+
+    def diagnostic(decision, body, ctx, epoch, stamp):
+        losses.append(decision.reason)
+        if decision.reason == "sweep_unknown" and not missing:
+            from shapely.geometry import Polygon
+
+            from senior_control.models import Velocity
+            from senior_control.motion.constraints import _world
+
+            cert = core.engine._sweep(ctx, Velocity(0, 0), stop_only=True, coarse=True)
+            required = _world(cert.physical_sweep, ctx.pose).difference(
+                _world(Polygon(ctx.footprint.physical_vertices), ctx.pose)
+            )
+            missing.append(
+                (
+                    required.difference(ctx.perception.free_space).area,
+                    required.difference(ctx.perception.free_space).bounds,
+                    cert.linear_domain,
+                    cert.yaw_domain,
+                )
+            )
+        return original(decision, body, ctx, epoch, stamp)
+
+    core._decision_output = diagnostic
+    phases = set()
+    captures = []
+    stopped_stamp = None
+    outputs = []
+    positions = [(50.0, 0.0)]
