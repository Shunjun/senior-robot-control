+        now[0] = t
+        publish_inputs(core)
+        core.prefetch_scan()
+        core.tick()
+    assert core.startup.state == "initializing" and core.startup.started is None
+    for i in range(1, 21):
+        t = now[0] = 50 + i * 0.05
