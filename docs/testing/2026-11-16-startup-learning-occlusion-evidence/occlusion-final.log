                        ),
                    ),
                    measurement_steady=stamp,
                )
            ]
            publish_inputs(core)
            core.prefetch_scan()
            core.tick()
            phases.add(core.startup.state)
            captures.append(stamp)
            outputs.append(core.node.emitted[-1][0].vx)
            if core.startup.state == "validating" and stopped_stamp is None:
