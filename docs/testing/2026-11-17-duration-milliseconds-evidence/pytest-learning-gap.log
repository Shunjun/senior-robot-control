    @pytest.mark.parametrize(
        "delay_pattern,late_device,motion_reordering,expected",
        [
            ((0.0,), False, False, "completed"),
            ((0.0,), True, False, "completed"),
            ((0.075, 0.025, 0.125, 0.025), False, False, "completed"),
            ((0.075, 0.025, 0.125, 0.025), True, False, "completed"),
            ((0.075, 0.025, 0.125, 0.025), False, True, "completed"),
        ],
    )
    def test_full_core_cycle_with_delayed_and_reordered_raw_scans(
        core,  # noqa: F811
        tmp_path,
        monkeypatch,
        delay_pattern,
        late_device,
        motion_reordering,
        expected,
    ):
        core.scheduler = ConstraintScheduler(core.engine, InlineWorker(), worker_budget_ms=250)
        bind_core(core, tmp_path / "claim")
        core.node._depth_policy = "laser_only"
        core.node._scan_topology_ready = lambda: True
        core.node._profile = lambda: DeviceProfile(
            footprint=[(-0.337, -0.276), (0.337, -0.276), (0.337, 0.276), (-0.337, 0.276)]
        )
        now = [10.0]
        monkeypatch.setattr("senior_robot.motion_core_output.time.monotonic", lambda: now[0])
        losses = []
        original_diagnose = core._diagnose_stopping
        original_output = core._decision_output
    
        def diagnose(ctx, reason, evaluation):
            if len(losses) < 24:
                print(
                    "TRACE_PERMISSION",
                    now[0],
                    reason,
                    "target",
                    ctx.target.velocity,
                    "body",
                    ctx.motion,
                    "footprint",
                    ctx.footprint,
                )
            return original_diagnose(ctx, reason, evaluation)
    
        def output(decision, body, ctx, epoch, stamp):
            if len(losses) < 24:
                print(
                    "TRACE_OUTPUT",
                    now[0],
                    decision,
                    "covered",
                    ctx.perception.covered if hasattr(ctx.perception, "covered") else ctx.perception,
                )
            losses.append(decision.reason)
            return original_output(decision, body, ctx, epoch, stamp)
    
        core._diagnose_stopping = diagnose
        core._decision_output = output
        phases = set()
        captures = []
        stopped_stamp = None
        outputs = []
        positions = [(50.0, 0.0)]
        # Real core initialization may wait longer than the learning budget.
        for t in (10.0, 50.0):
            now[0] = t
            publish_inputs(core)
            core.prefetch_scan()
            core.tick()
        assert core.startup.state == "initializing" and core.startup.started is None
        for i in range(1, 21):
            t = now[0] = 50 + i * 0.05
            # Explicit synthetic zero-order plant: the preceding actual core output
            # supplies the next measured speed. No permit or obstacle is patched.
            v = core.node.emitted[-1][0].vx if core.node.emitted else 0.0
            positions.append((t, positions[-1][1] + v * 0.05))
            core.node._reception_test.sensors.ingest(point(Source.WHEEL, t, t, (v, 0.0), i), t, t, t)
            core.node._reception_test.sensors.ingest(point(Source.IMU, t, t, (0.0,), i), t, t, t)
            core.node._reception_test.sensors.ingest_observation(
                MotionObservation(
                    "laser",
                    (v, 0.0, 0.0),
                    t,
                    (
                        Origin(
                            "laser",
                            "native",
                            i,
                            t,
                            t,
                            t,
                            measurement_steady=t,
                            measurement=capture_time(t).measurement,
                        ),
                    ),
                    quality=1.0,
                    independent=(True, True, True),
                    measured_steady=t,
                    measurement=capture_time(t).measurement,
                    # v is the preceding output actually applied throughout this
