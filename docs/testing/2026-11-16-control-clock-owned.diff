+// Deterministic IO/clock model around the exact production C++ receiver.
+// This does not exercise Linux socket semantics, ROS, DDS or target ABI.
+#include <array>
+#include <atomic>
+#include <chrono>
+#include <cerrno>
+#include <cstdlib>
+#include <cmath>
+#include <cstdint>
+#include <cstring>
