+def wire_float32(value):
+    import struct
+
+    return struct.unpack("f", struct.pack("f", value))[0]
+
+
+def wire_seam_observation(count, step, *, inclusive=False):
+    ranges = [float("nan")] * count
+    ranges[0], ranges[1] = wire_float32(0.4), wire_float32(0.5)
+    if inclusive:
+        ranges[-2], ranges[-1] = wire_float32(0.15), wire_float32(0.4)
+    else:
+        ranges[-1] = wire_float32(0.15)
+    scan = replace(
+        dense_surface().scan,
+        ranges=tuple(ranges),
+        angle_min=wire_float32(-math.pi),
+        angle_increment=step,
+        range_min=wire_float32(0.05),
+        range_max=wire_float32(20),
+    )
+    return filter_self(scan, DeviceProfile(footprint=BOUNDARY))
