# coturn 配置模板，不是运行中的服务。
# 这台机器没有启动 coturn。占位符 __NAME__ 在部署时由部署流程替换，仓库里不放真实值。
#
# 凭据方案：REST 临时凭据（use-auth-secret）。
#   username   = "<过期时间戳>:<session_id>"
#   credential = base64(HMAC-SHA1(共享密钥, username))
# 云端与车端用同一个共享密钥签发。coturn 用 static-auth-secret 验证，并拒绝已过期的 username。
# 共享密钥至少 32 字节随机数据，对应 senior_control.vision.turn.TurnConfig 的下限。

# ---- 监听 ------------------------------------------------------------------
listening-port=3478
tls-listening-port=5349
# 对外地址。NAT 之后的主机要同时写内网地址和公网地址：external-ip=<公网>/<内网>
listening-ip=__LISTEN_IP__
external-ip=__EXTERNAL_IP__
realm=__TURN_REALM__
server-name=__TURN_REALM__
fingerprint

# ---- 认证 ------------------------------------------------------------------
lt-cred-mech
use-auth-secret
static-auth-secret=__TURN_SHARED_SECRET__
stale-nonce=600

# ---- TLS（turns:） ----------------------------------------------------------
cert=__TLS_CERT_PATH__
pkey=__TLS_KEY_PATH__
no-tlsv1
no-tlsv1_1

# ---- 中继端口与配额 ----------------------------------------------------------
min-port=49160
max-port=49200
# 单个凭据（即单个观看会话）最多同时持有的分配数
user-quota=4
# 整台服务器同时持有的分配数上限
total-quota=40
# 单个分配的带宽上限，单位 bit/s。与 VideoLimits.max_bitrate_bps 对齐并留出余量
max-bps=2000000
# 整台服务器的带宽上限，单位 bit/s
bps-capacity=20000000

# ---- 只中继媒体，不当跳板 ----------------------------------------------------
no-tcp-relay
no-multicast-peers
no-cli
no-software-attribute
# 不允许中继到内网与链路本地地址，避免 TURN 变成探测内网的入口
denied-peer-ip=0.0.0.0-0.255.255.255
denied-peer-ip=10.0.0.0-10.255.255.255
denied-peer-ip=100.64.0.0-100.127.255.255
denied-peer-ip=127.0.0.0-127.255.255.255
denied-peer-ip=169.254.0.0-169.254.255.255
denied-peer-ip=172.16.0.0-172.31.255.255
denied-peer-ip=192.0.0.0-192.0.0.255
denied-peer-ip=192.168.0.0-192.168.255.255
denied-peer-ip=198.18.0.0-198.19.255.255
denied-peer-ip=240.0.0.0-255.255.255.255
denied-peer-ip=::1
denied-peer-ip=fc00::-fdff:ffff:ffff:ffff:ffff:ffff:ffff:ffff
denied-peer-ip=fe80::-febf:ffff:ffff:ffff:ffff:ffff:ffff:ffff

# ---- 日志 ------------------------------------------------------------------
# 不记录密钥。username 含过期时间和不透明的会话 id，可以出现在日志里。
log-file=stdout
simple-log
