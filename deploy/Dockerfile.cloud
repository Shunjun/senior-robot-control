FROM ghcr.io/astral-sh/uv:0.12.23 AS uv
FROM python:3.10.15-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH=/app/cloud/.venv/bin:$PATH

WORKDIR /app
COPY --from=uv /uv /bin/uv
COPY cloud ./cloud
COPY contracts ./contracts
RUN uv sync --project cloud --frozen --no-dev --extra server --no-editable \
    && python -c "import uvicorn.protocols.websockets.websockets_impl"

RUN useradd --system --user-group --uid 10001 --home /nonexistent senior \
    && mkdir -p /var/lib/senior \
    && chown 10001:10001 /var/lib/senior
USER 10001:10001

EXPOSE 8000
CMD ["python", "-m", "cloud.bootstrap"]
