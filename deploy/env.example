# Use as deploy/.env for manual Compose or as the Jenkins Secret file.
# Replace placeholders and keep each complete value in single quotes.
DOMAIN='<cloud-domain>'
ACME_EMAIL='<contact-email>'
SENIOR_SECRET='<random-32-byte-or-longer-secret>'
ADMIN_PASSWORD_HASH='<scrypt$16384$8$1$salt$hash>'
# Optional TURN settings. Omit ENABLE_TURN to keep it disabled.
# ENABLE_TURN='true'
# TURN_LISTEN_IP='<listen-ip>'
# TURN_EXTERNAL_IP='<public-ip>'
# TURN_REALM='<turn-domain>'
# TURN_SHARED_SECRET='<random-32-byte-or-longer-secret>'
