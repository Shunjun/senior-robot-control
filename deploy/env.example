# Copy to deploy/.env and replace every angle-bracket placeholder.
DOMAIN=<cloud-domain>
SENIOR_SECRET=<random-32-byte-or-longer-secret>
ADMIN_PASSWORD_HASH=<argon2-password-hash>
TURN_REALM=<turn-domain>
TURN_SHARED_SECRET=<random-32-byte-or-longer-secret>
TURN_LISTEN_IP=<cloud-listen-address>
TURN_EXTERNAL_IP=<cloud-public-address>
